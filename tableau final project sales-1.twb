    <dashboard name='Insights &amp; Recommendations' type='storyboard'>
      <style />
      <size maxheight='680' maxwidth='1200' minheight='680' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
